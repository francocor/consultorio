{
  "name": "@consultorio/api",
  "version": "0.0.0",
  "private": true,
  "description": "Fastify API and worker (modular monolith)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main/main.ts api",
    "dev:worker": "tsx watch --env-file-if-exists=../../.env src/main/main.ts worker",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "tsx scripts/check-migration-drift.ts",
    "build": "tsx scripts/build.ts"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1152.0",
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-presigned-post": "^3.1152.0",
    "@node-rs/argon2": "^2.2.2",
    "@oslojs/encoding": "^1.1.0",
    "@oslojs/otp": "^1.1.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "nodemailer": "^10.1.1",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@consultorio/config": "workspace:*",
    "@consultorio/contracts": "workspace:*",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^24",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  }
}
