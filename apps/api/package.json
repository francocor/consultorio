{
  "name": "@consultorio/api",
  "version": "0.0.0",
  "private": true,
  "description": "Fastify API and worker (modular monolith)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main/main.ts api",
    "dev:worker": "tsx watch --env-file-if-exists=../../.env src/main/main.ts worker",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "db:generate": "node -e \"console.error('db:generate is replaced by: pnpm db:new <track> <name> (docs/migration-ranges.md)'); process.exit(1)\"",
    "db:new": "tsx scripts/new-migration.ts",
    "db:restamp": "tsx scripts/restamp-migrations.ts",
    "db:check": "tsx scripts/check-migration-drift.ts",
    "operator:create": "tsx --env-file-if-exists=../../.env scripts/create-operator.ts",
    "operator:code": "tsx scripts/totp-code.ts",
    "build": "tsx scripts/build.ts",
    "demo:seed": "tsx --env-file-if-exists=../../.env scripts/demo-seed.ts",
    "demo:reset": "tsx --env-file-if-exists=../../.env scripts/demo-reset.ts",
    "demo:platform": "tsx --env-file-if-exists=../../.env scripts/demo-platform.ts",
    "e2e:stack": "tsx scripts/e2e-stack.ts --port 3100 --info ../web/e2e/.stack/info.json",
    "demo:stack": "tsx scripts/e2e-stack.ts --port 3000 --minio-port 9100 --banner",
    "backup:local": "tsx scripts/backup-local.ts",
    "drill:restore": "tsx --env-file-if-exists=../../.env scripts/restore-drill.ts",
    "dev:afip-cert": "tsx scripts/dev-afip-cert.ts",
    "archive:legal-erase": "tsx --env-file-if-exists=../../.env scripts/archive-legal-erase.ts",
    "bench:clinical": "tsx scripts/bench-clinical-readable.ts"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1152.0",
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-presigned-post": "^3.1152.0",
    "@node-rs/argon2": "^2.2.2",
    "@oslojs/encoding": "^1.1.0",
    "@oslojs/otp": "^1.1.0",
    "@react-pdf/renderer": "^4.9.0",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "luxon": "^3.7.2",
    "nodemailer": "^10.1.1",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@consultorio/config": "workspace:*",
    "@consultorio/contracts": "workspace:*",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/luxon": "^3.7.6",
    "@types/node": "^24",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  }
}
