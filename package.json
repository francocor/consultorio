{
  "name": "health-practice-saas",
  "version": "0.0.0",
  "private": true,
  "description": "Health practice SaaS",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present run dev",
    "build": "pnpm -r --if-present run build",
    "typecheck": "tsc --noEmit && pnpm -r --if-present run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:integration": "pnpm -r --if-present run test:integration",
    "test:e2e": "pnpm -r --if-present run test:e2e",
    "test:coverage": "vitest run --coverage"
  },
  "prettier": "@consultorio/config/prettier.config.js",
  "devDependencies": {
    "@consultorio/config": "workspace:*",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10",
    "prettier": "^3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  }
}
