{
  "name": "health-practice-saas",
  "version": "0.0.0",
  "private": true,
  "description": "Health practice SaaS",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present run dev",
    "build": "pnpm -r --if-present run build",
    "typecheck": "tsc --noEmit && pnpm -r --if-present run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:integration": "pnpm -r --if-present run test:integration",
    "test:e2e": "pnpm -r --if-present run test:e2e",
    "test:coverage": "vitest run --coverage",
    "db:check": "pnpm --filter @consultorio/api db:check",
    "infra:up": "docker compose --env-file .env -f infra/docker-compose.yml up -d --wait postgres minio mailpit && docker compose --env-file .env -f infra/docker-compose.yml run --rm --no-deps minio-init",
    "infra:down": "docker compose --env-file .env -f infra/docker-compose.yml down",
    "infra:reset": "docker compose --env-file .env -f infra/docker-compose.yml down -v",
    "prepare": "node -e \"require('node:fs').existsSync('.git')&&require('node:child_process').execSync('lefthook install',{stdio:'inherit'})\""
  },
  "prettier": "@consultorio/config/prettier.config.js",
  "devDependencies": {
    "@consultorio/config": "workspace:*",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10",
    "lefthook": "^2.2.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html}": "prettier --write"
  }
}
