{
  "uid": "consultorio-platform",
  "title": "Consultorio: plataforma",
  "tags": ["consultorio"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Trabajos en las colas",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (queue, state) (queue_jobs)",
          "legendFormat": "{{queue}} ({{state}})"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Espera del trabajo más antiguo (segundos)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (queue) (queue_oldest_waiting_seconds)",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Mensajes de las últimas 24 horas",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (messages_last_day)",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Facturas pendientes pasado el umbral",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "invoices_pending_past_threshold" }]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Documentos esperando el análisis",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "documents_scan_backlog" }]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Eventos de auditoría sin sellar",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "audit_unsealed_events" }]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Cadenas de auditoría rotas",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(audit_chain_break_total) + sum(platform_audit_chain_break_total)"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Suscripciones por estado",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (status) (subscriptions)", "legendFormat": "{{status}}" }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Suscripciones con pago pendiente, por aviso alcanzado",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (step) (subscription_dunning_step)",
          "legendFormat": "aviso {{step}}"
        }
      ]
    }
  ]
}
