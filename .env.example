# Copy to .env for local development:  cp .env.example .env
# This file is committed, so it must only ever contain safe placeholders. Real secrets live in the
# environment of each deployment (AWS SSM Parameter Store in production) and never in git.

# --- Application (apps/api) ---------------------------------------------------------------------
# development | test | production
NODE_ENV=development
# multi: many tenants on one deployment. single: one organization, signup and billing routes off.
DEPLOYMENT_MODE=multi
# multi mode: tenants are served at {slug}.BASE_DOMAIN and the operator console at PLATFORM_HOST.
# Host names only (no scheme, port or path). *.localhost resolves to 127.0.0.1 in current browsers.
BASE_DOMAIN=localhost
PLATFORM_HOST=platform.localhost
# single mode: the slug of the one organization this deployment serves (leave empty in multi mode).
SINGLE_TENANT_SLUG=
# Secure cookies. Leave empty: false in development, true in production (production refuses false).
COOKIE_SECURE=
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
HOST=0.0.0.0
PORT=3000

# --- Key management (envelope encryption of clinical fields) ----------------------------------
# local: a key-encryption key (KEK) from the environment. Development and tests only: production
# refuses it. aws: AWS KMS, which holds the KEK and never hands it out.
KMS_PROVIDER=local
# 32 random bytes, base64. This value is a public development placeholder, never use it elsewhere.
KMS_LOCAL_KEK_BASE64=ZGV2X29ubHlfbG9jYWxfa2VrXzAxMjM0NTY3ODlhYmM=
# Only for KMS_PROVIDER=aws.
AWS_REGION=
AWS_KMS_KEY_ID=

# --- Database -------------------------------------------------------------------------------------
# Runtime connection. Uses app_rw: it owns no table and cannot bypass row level security.
DATABASE_URL=postgres://app_rw:app_rw_dev_only@localhost:5432/consultorio
# Migrations connection (pnpm --filter @consultorio/api db:migrate). Uses app_owner.
MIGRATION_DATABASE_URL=postgres://app_owner:app_owner_dev_only@localhost:5432/consultorio

# --- Local services (infra/docker-compose.yml) ------------------------------------------------
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres_dev_only
POSTGRES_DB=consultorio
POSTGRES_PORT=5432

MINIO_ROOT_USER=minio_dev
MINIO_ROOT_PASSWORD=minio_dev_only_secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=consultorio-files

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

CLAMAV_PORT=3310
API_PORT=3000
