# Copy to .env for local development:  cp .env.example .env
# This file is committed, so it must only ever contain safe placeholders. Real secrets live in the
# environment of each deployment (AWS SSM Parameter Store in production) and never in git.

# --- Application (apps/api) ---------------------------------------------------------------------
# development | test | production
NODE_ENV=development
# multi: many tenants on one deployment. single: one organization, signup and billing routes off.
DEPLOYMENT_MODE=multi
# multi mode: tenants are served at {slug}.BASE_DOMAIN and the operator console at PLATFORM_HOST.
# Host names only (no scheme, port or path). *.localhost resolves to 127.0.0.1 in current browsers.
BASE_DOMAIN=localhost
PLATFORM_HOST=platform.localhost
# single mode: the slug of the one organization this deployment serves (leave empty in multi mode).
SINGLE_TENANT_SLUG=
# Secure cookies. Leave empty: false in development, true in production (production refuses false).
COOKIE_SECURE=
# How many reverse proxies sit in front of the app: the client address is the X-Forwarded-For entry
# that many hops from the right (a client cannot forge it). A comma-separated list of proxy
# addresses or ranges (10.0.0.0/8,192.168.1.5) also works. "true" is refused. Leave it empty:
# false in development, 1 in production (one reverse proxy; the app must not be reachable directly).
TRUST_PROXY=
# single mode: the origin the deployment is served from. Emailed links (password reset, invitation)
# are built from it, never from the Host header of a request. https in production.
PUBLIC_URL=
# multi mode, development only: the port of the web app in emailed links (pnpm dev serves 5173).
PUBLIC_PORT=
# Transactional email (password reset, staff invitations). Locally it goes to Mailpit
# (pnpm infra:up, inbox at http://localhost:8025). In production it is the SES SMTP interface with
# SMTP_SECURITY=starttls; SMTP_USER and SMTP_PASSWORD are then set by the deployment, not here.
SMTP_HOST=localhost
SMTP_PORT=1025
# none | starttls | tls (production refuses none)
SMTP_SECURITY=none
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Consultorio <no-responder@localhost>
# Passwords are always checked against the common-password list that ships with the API (nothing
# leaves the server). Setting this to true also asks a breach range API about the first five
# characters of the password hash (never the password) for new passwords.
AUTH_BREACH_CHECK=false
# Account lockout: this many consecutive failed sign-ins (wrong password or wrong second-factor
# code) lock the account for AUTH_LOCKOUT_MINUTES. Backoff delays apply before the lock.
AUTH_LOCKOUT_MAX_FAILURES=10
AUTH_LOCKOUT_MINUTES=15
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
HOST=0.0.0.0
PORT=3000

# --- Key management (envelope encryption of clinical fields) ----------------------------------
# local: a key-encryption key (KEK) from the environment. Development and tests only: production
# refuses it. aws: AWS KMS, which holds the KEK and never hands it out.
KMS_PROVIDER=local
# 32 random bytes, base64. This value is a public development placeholder, never use it elsewhere.
KMS_LOCAL_KEK_BASE64=ZGV2X29ubHlfbG9jYWxfa2VrXzAxMjM0NTY3ODlhYmM=
# Only for KMS_PROVIDER=aws.
AWS_REGION=
AWS_KMS_KEY_ID=

# --- Object storage (logos now, documents later) -----------------------------------------------
# Locally it is MinIO (pnpm infra:up creates the bucket named by S3_BUCKET below). In production it
# is AWS S3: leave S3_ENDPOINT and the keys empty, the task role supplies the credentials and the
# bucket default encryption (SSE-KMS) protects the objects. Without S3_BUCKET the API starts but
# logo upload is unavailable.
S3_ENDPOINT=http://localhost:9000
# Defaults to AWS_REGION, then us-east-1 (what MinIO expects).
S3_REGION=
# Defaults to true when S3_ENDPOINT is set (MinIO needs path-style addressing).
S3_FORCE_PATH_STYLE=
# Local MinIO only (the same root credentials as MINIO_ROOT_USER / MINIO_ROOT_PASSWORD below).
# Production refuses static keys.
S3_ACCESS_KEY_ID=minio_dev
S3_SECRET_ACCESS_KEY=minio_dev_only_secret

# --- Database -------------------------------------------------------------------------------------
# Runtime connection. Uses app_rw: it owns no table and cannot bypass row level security.
DATABASE_URL=postgres://app_rw:app_rw_dev_only@localhost:5432/consultorio
# The most connections the runtime pool opens (14 to 100, default 16). A job that waits for the authority
# (afip.issue), the e-prescription provider (erx.reconcile) or the mail server (portal.notice_sweep) holds
# one connection idle and asks for a second one for its own work: size it for the jobs the worker runs at
# once (docs/runbooks/afip-switch-to-real.md). 14 is a floor, not a size: the API and the worker refuse to
# start below it.
DB_POOL_MAX=48
# Migrations connection (pnpm --filter @consultorio/api db:migrate). Uses app_owner.
MIGRATION_DATABASE_URL=postgres://app_owner:app_owner_dev_only@localhost:5432/consultorio
# Platform operator console (multi mode only). Uses app_operator: a separate login with an allowlist
# of privileges (no patient or clinical table). Leave it empty and the console does not exist:
# every /operator/* path answers 404. Create the first operator with
#   OPERATOR_PASSWORD='a long passphrase' pnpm --filter @consultorio/api operator:create --email you@example.com --name "Your Name"
OPERATOR_DATABASE_URL=postgres://app_operator:app_operator_dev_only@localhost:5432/consultorio

# Audit sealer: the login that seals and verifies the audit trails (role audit_sealer). Only the
# WORKER process needs it and the worker refuses to start without it; the API process must not have
# it. It can fill the hash-chain columns of the audit trails and nothing else.
AUDIT_SEALER_DATABASE_URL=postgres://audit_sealer:audit_sealer_dev_only@localhost:5432/consultorio

# --- Local services (infra/docker-compose.yml) ------------------------------------------------
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres_dev_only
POSTGRES_DB=consultorio
POSTGRES_PORT=5432

MINIO_ROOT_USER=minio_dev
MINIO_ROOT_PASSWORD=minio_dev_only_secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# Bucket name, for the API and for the compose job that creates it.
S3_BUCKET=consultorio-files

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

CLAMAV_PORT=3310
API_PORT=3000

# Releaser process only (archive break-glass delivery). Never set it on the api or the worker.
RELEASER_DATABASE_URL=postgres://app_releaser:app_releaser_dev_only@localhost:5432/consultorio
